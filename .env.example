# Settings for the Library Claim Agent.
# The start script fills in GOOGLE_API_KEY for you the first time (it asks you to paste it).

# Free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=replace-me

# Valuation country and currency, and the second country used for the 10-book comparison
COUNTRY=IN
CURRENCY=INR
SECOND_COUNTRY=US
SECOND_CURRENCY=USD

# Books priced above this (in CURRENCY) go to human appraisal instead of being priced
APPRAISAL_THRESHOLD=5000

# ---- Advanced: leave these alone unless you know you need them ----

# Models are picked automatically by the doctor (python -m app.doctor) and saved in
# data/models.json. Uncomment to force a specific model.
# LIVE_MODEL=
# VISION_MODEL=
# PRICING_MODEL=
LIVE_VOICE=Kore

# Free-tier rate limits (requests per minute). Raise them on a paid key.
VISION_RPM=10
PRICING_RPM=10
PRICING_BATCH=5

# Optional: free Google Cloud API key with the Books API enabled (the keyless quota is shared per internet connection)
GOOGLE_BOOKS_API_KEY=

# Network compatibility (office proxies, broken IPv6). On by default; harmless at home.
USE_OS_TRUST=1
FORCE_IPV4=1

# Optional: USD list prices to turn token counts into a cost-per-sweep figure
COST_IN_PER_M=0
COST_OUT_PER_M=0
COST_PER_GROUNDED_CALL=0
COST_LIVE_PER_MIN=0
